// Prisma schema for Where Did It Go (Personal Expense Intelligence Platform)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurrenceCadence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  currency     String        @default("USD")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringRule[]
  syncQueue    SyncQueueItem[]
}

model Category {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String        @default("#3b82f6")
  icon         String        @default("Tag")
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
}

model Transaction {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type          TransactionType @default(EXPENSE)
  amount        Decimal         @db.Decimal(14, 2)
  currency      String          @default("USD")
  description   String
  transactionDate DateTime
  isRecurring   Boolean         @default(false)
  recurringRuleId String?
  receiptUrl    String?
  notes         String?
  isOfflineSync Boolean         @default(false)
  localId       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  receiptAttachments ReceiptAttachment[]

  @@index([userId, transactionDate])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      Int      // 1-12
  year       Int
  limitAmount Decimal @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, year, month])
}

model RecurringRule {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType   @default(EXPENSE)
  amount      Decimal           @db.Decimal(14, 2)
  categoryId  String?
  description String
  cadence     RecurrenceCadence @default(MONTHLY)
  startDate   DateTime
  endDate     DateTime?
  lastRunDate DateTime?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ReceiptAttachment {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  fileSize      Int
  storagePath   String
  uploadedAt    DateTime    @default(now())
}

model SyncQueueItem {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientEntityId String
  entityType  String
  payloadJson String
  clientVersion Int    @default(1)
  applied     Boolean  @default(false)
  createdAt   DateTime @default(now())
}
